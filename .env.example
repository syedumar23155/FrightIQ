# Google Maps browser key (restrict by website referrer and Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=

# Server-only AISStream key. Do not add the VITE_ prefix.
AISSTREAM_API_KEY=

# Optional AIS service settings
AIS_HTTP_HOST=127.0.0.1
AIS_HTTP_PORT=8790
AIS_ACTIVE_WINDOW_MINUTES=120
STATIONARY_HOURS=48
STATIONARY_SPEED_KNOTS=1
STATIONARY_RADIUS_KM=1
# Set AIS_MODE=mock to exercise the UI with visibly simulated data.
AIS_MODE=
